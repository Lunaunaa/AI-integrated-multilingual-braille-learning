# Copy values into your local environment; never put real credentials in version control.
ENV=development
RESONANT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# JWT secret for signing teacher tokens (Required: server fails at startup if missing)
RESONANT_JWT_SECRET=your-secure-random-secret-key-min-32-chars

# AI & LLM Service
RESONANT_OLLAMA_URL=http://localhost:11434
RESONANT_OLLAMA_MODEL=qwen2.5:0.5b
RESONANT_AI_ENABLED=true

# Allowed CORS origins (comma-separated, e.g. http://localhost:8000,http://10.0.2.2:8000)
RESONANT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
